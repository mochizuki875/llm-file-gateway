VLLM_MODEL=your-model-name
VLLM_BASE_URL=http://vllm-host:8000/v1
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_AUTH_REQUIRED=false
GATEWAY_API_KEY=your-gateway-api-key
VLLM_API_KEY=your-vllm-api-key
GATEWAY_DATA_DIR=./gateway-data
# Default file retention period (sec) and upper limit for expires_after.seconds (0 for unlimited)
FILE_TTL_SECONDS=300
# Maximum size of a single file (bytes) (0 for unlimited)
MAX_FILE_BYTES=52428800
# Maximum size of inference request bodies (bytes). Defaults to 4x MAX_FILE_BYTES (0 for unlimited)
MAX_REQUEST_BODY_BYTES=209715200
# Maximum number of pages to convert to images (0 for unlimited). Applied to both conversion and forwarding to vLLM
MAX_DOCUMENT_PAGES=50
# Maximum number of characters extracted from a single file (0 for unlimited)
MAX_DOCUMENT_TEXT_CHARS=500000
# Maximum size of PDFs processed by the renderer (bytes) (0 for unlimited)
MAX_DOCUMENT_PDF_BYTES=134217728
# Maximum width and height (px) of a rendered page (0 for unlimited)
MAX_DOCUMENT_PAGE_WIDTH=20000
MAX_DOCUMENT_PAGE_HEIGHT=20000
# Maximum number of pixels of a single page and of an entire document (0 for unlimited)
MAX_DOCUMENT_PAGE_PIXELS=200000000
MAX_DOCUMENT_PIXELS=1000000000
# Maximum number of members, per-member size, and total decompressed size of an OOXML archive (0 for unlimited)
MAX_DOCUMENT_OOXML_MEMBERS=10000
MAX_DOCUMENT_OOXML_MEMBER_BYTES=268435456
MAX_DOCUMENT_OOXML_TOTAL_BYTES=1073741824
DOCUMENT_DPI=300
# Timeout (sec) for PDF/Office image conversion (0 for unlimited)
DOCUMENT_RENDER_TIMEOUT_SECONDS=300
# Timeout (sec) for LibreOffice used in Office conversion (0 for unlimited)
DOCUMENT_LIBREOFFICE_TIMEOUT_SECONDS=300
DOCUMENT_TEXT_EXTRACTION_ENABLED=true
CONVERSION_WORKERS=2
# Number of conversion jobs waiting for a worker that can be held in the queue (0 for unlimited)
CONVERSION_QUEUE_CAPACITY=0
# Deadline (sec) shared across file waiting, preparation, and vLLM communication until response headers start being returned. Once a response has started, delivery is not interrupted for either streaming or non-streaming (0 for unlimited)
REQUEST_TIMEOUT_SECONDS=300
LOGLEVEL=0